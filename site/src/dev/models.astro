---
/**
 * The Model Gallery (`/dev/models`, dev only; see `integrations/modelGallery.ts`):
 * every predefined structure in a Biome × Variant grid, drawn with the
 * World's renderer, soft-voxel material and light. On a wide screen Biomes
 * run across and Variants down; on a tall one (a phone) the two swap, so
 * each model stays large enough to judge. Turn the models a quarter at a
 * time, lift the House lids, and switch Day and Night (the page's own
 * colours follow, from the site's theme tokens).
 */
import '@fontsource/jersey-20';
import '@fontsource/jersey-15';
import { BIOME_IDS, DECORATION_KINDS } from '@/world';
import { STRUCTURES } from '@/structures';
import { site } from '@/data/site';
import { themeCss } from '@/data/theme';

const decoration: readonly string[] = DECORATION_KINDS;
const kinds = [...new Set(STRUCTURES.map((s) => s.kind))].filter((kind) => !decoration.includes(kind));
const { colour, fonts } = site.brand;
---

<!doctype html>
<html lang="en" data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Model Gallery</title>
    <link rel="icon" href="data:," />
    <style is:inline set:html={themeCss()}></style>
  </head>
  <body style={`--brand: ${colour}; --font-body: ${fonts.body}; --font-heading: ${fonts.heading};`}>
    <header class="bar">
      <h1>Model Gallery <span class="dev">dev</span></h1>
      <div class="controls">
        <label class="kind">
          <span>Kind</span>
          <select data-kind>
            {kinds.map((kind) => <option value={kind}>{kind}</option>)}
            <optgroup label="Decoration">
              {DECORATION_KINDS.map((kind) => <option value={kind}>{kind}</option>)}
            </optgroup>
          </select>
        </label>
        <button type="button" data-turn title="Turn a quarter" aria-label="Turn a quarter">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M20 12a8 8 0 1 1-2.3-5.6M20 4v4.5h-4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="text">Turn</span>
        </button>
        <button type="button" data-lids aria-pressed="false" title="Lift lids">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M3 10 12 4l9 6M6 14v6h12v-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="text">Lift lids</span>
        </button>
        <button type="button" data-theme-switch aria-pressed="false" title="Night">
          <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
          </svg>
          <span class="text">Night</span>
        </button>
      </div>
      <span class="count" data-count aria-live="polite"></span>
    </header>
    <main class="stage">
      <canvas data-canvas aria-label="Every structure of the chosen kind, by Biome and Variant"></canvas>
      <div class="labels" data-labels></div>
    </main>
    <footer class="note">
      Biomes: {BIOME_IDS.join(', ')}, then structures shared by every Biome. Each model stands on its Biome's grass (boats and ships float on its sea, fish lie on it; birds and bats hang over it). For review
      only; never built.
    </footer>
  </body>
</html>

<script>
  import { mountGallery } from './modelGallery';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-canvas]')!;
  const labels = document.querySelector<HTMLElement>('[data-labels]')!;
  const kind = document.querySelector<HTMLSelectElement>('[data-kind]')!;
  const theme = document.querySelector<HTMLButtonElement>('[data-theme-switch]')!;
  const lids = document.querySelector<HTMLButtonElement>('[data-lids]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const gallery = await mountGallery(canvas, labels);
  const pressed = (button: HTMLButtonElement) => button.getAttribute('aria-pressed') === 'true';
  const show = () => {
    const n = gallery.show(kind.value);
    count.textContent = `${n} model${n === 1 ? '' : 's'} · ${gallery.backend}`;
  };
  show();
  kind.addEventListener('change', show);
  document.querySelector('[data-turn]')!.addEventListener('click', () => gallery.turn());
  lids.addEventListener('click', () => {
    const on = !pressed(lids);
    lids.setAttribute('aria-pressed', String(on));
    gallery.liftLids(on);
  });
  theme.addEventListener('click', () => {
    const night = !pressed(theme);
    theme.setAttribute('aria-pressed', String(night));
    document.documentElement.dataset.theme = night ? 'night' : 'day';
    gallery.setTheme(night ? 'night' : 'day');
  });
</script>

<style>
  /* Colour tokens (--ink, --paper, --surface, --brand-ink, --on-brand, --shadow) come from data/theme.ts, inlined in <head>. */
  :global(:root) {
    --radius: 6px;
    --gutter: 1rem;
    --line: color-mix(in oklab, var(--ink) 18%, transparent);
    --card: color-mix(in oklab, var(--paper) 92%, transparent);
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklab, var(--ink) 35%, transparent) transparent;
  }
  :global(body) {
    margin: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    /* Jersey 20 is drawn on a 20px grid: 20px keeps its pixels whole. */
    font: 1.25rem / 1.3 var(--font-body);
    font-synthesis: none;
    color: var(--ink);
    background: var(--paper);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.75rem var(--gutter);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }
  h1 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font: 400 1.875rem / 1 var(--font-heading);
  }
  .dev {
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius);
    font: 1rem / 1.2 var(--font-body);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--on-brand);
    background: var(--brand);
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .kind {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  button,
  select {
    min-height: 2.5rem;
    padding: 0 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    cursor: pointer;
  }
  select {
    text-transform: capitalize;
  }
  button {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  button:hover,
  select:hover {
    border-color: var(--brand-ink);
  }
  button[aria-pressed='true'] {
    color: var(--on-brand);
    background: var(--brand);
    border-color: var(--brand);
  }
  button:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--brand-ink);
    outline-offset: 2px;
  }
  .count {
    margin-left: auto;
    color: color-mix(in oklab, var(--ink) 70%, transparent);
    white-space: nowrap;
  }

  .stage {
    position: relative;
    min-height: 0;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: manipulation;
  }
  .labels {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .labels :global(span) {
    position: absolute;
    transform: translate(-50%, 0);
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius);
    font-size: 1rem;
    text-transform: capitalize;
    white-space: nowrap;
    color: var(--ink);
    background: var(--card);
    box-shadow: 0 2px 8px var(--shadow);
  }

  .note {
    padding: 0.5rem var(--gutter);
    border-top: 1px solid var(--line);
    font-size: 1rem;
    color: color-mix(in oklab, var(--ink) 75%, transparent);
    background: var(--surface);
  }

  /* Phones: icon-only buttons (labels stay as tooltips and for screen readers), the count on its own line. */
  @media (max-width: 47.99rem) {
    :global(:root) {
      --gutter: 0.75rem;
    }
    .bar {
      gap: 0.5rem;
    }
    h1 {
      font-size: 1.5rem;
    }
    .controls {
      order: 2;
      flex: 1 1 100%;
    }
    .kind {
      flex: 1 1 auto;
    }
    .kind select {
      flex: 1;
    }
    button .text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    button {
      justify-content: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
      padding: 0;
    }
    select {
      min-height: 2.75rem;
    }
    .count {
      font-size: 1rem;
    }
    .note {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    button,
    select {
      transition:
        background-color 120ms,
        border-color 120ms,
        color 120ms;
    }
  }
</style>
