---
/**
 * The Model Gallery (`/dev/models`, dev only; see `integrations/modelGallery.ts`):
 * every predefined structure in a Biome × Variant grid (Biomes across, Variants down), drawn with the
 * World's renderer, soft-voxel material and light. Turn the models a
 * quarter at a time, lift the House lids, and switch Day and Night.
 */
import { BIOME_IDS } from '@/world';
import { STRUCTURES } from '@/structures';

const kinds = [...new Set(STRUCTURES.map((s) => s.kind))];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Model Gallery</title>
  </head>
  <body>
    <header class="bar">
      <h1>Model Gallery</h1>
      <label>
        Kind
        <select data-kind>
          {kinds.map((kind) => <option value={kind}>{kind}</option>)}
        </select>
      </label>
      <button type="button" data-turn>Turn ↻</button>
      <label><input type="checkbox" data-lids /> Lift lids</label>
      <button type="button" data-theme aria-pressed="false">Night</button>
      <span class="count" data-count></span>
    </header>
    <main class="stage">
      <canvas data-canvas></canvas>
      <div class="labels" data-labels></div>
    </main>
    <p class="note">Columns: Biomes ({BIOME_IDS.join(', ')}), then structures shared by every Biome. Rows: Variants. For review only; never built.</p>
  </body>
</html>

<script>
  import { mountGallery } from './modelGallery';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-canvas]')!;
  const labels = document.querySelector<HTMLElement>('[data-labels]')!;
  const kind = document.querySelector<HTMLSelectElement>('[data-kind]')!;
  const theme = document.querySelector<HTMLButtonElement>('[data-theme]')!;
  const lids = document.querySelector<HTMLInputElement>('[data-lids]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const gallery = await mountGallery(canvas, labels);
  const show = () => {
    const n = gallery.show(kind.value);
    count.textContent = `${n} model${n === 1 ? '' : 's'} · ${gallery.backend}`;
  };
  show();
  kind.addEventListener('change', show);
  document.querySelector('[data-turn]')!.addEventListener('click', () => gallery.turn());
  lids.addEventListener('change', () => gallery.liftLids(lids.checked));
  theme.addEventListener('click', () => {
    const night = theme.getAttribute('aria-pressed') !== 'true';
    theme.setAttribute('aria-pressed', String(night));
    theme.textContent = night ? 'Day' : 'Night';
    gallery.setTheme(night ? 'night' : 'day');
  });
</script>

<style>
  :root {
    color-scheme: light dark;
    font-family: system-ui, sans-serif;
  }
  body {
    margin: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100vh;
    background: #e9eef2;
    color: #1f2630;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    align-items: center;
    padding: 8px 16px;
  }
  h1 {
    font-size: 18px;
    margin: 0 8px 0 0;
  }
  button,
  select {
    font: inherit;
    padding: 4px 10px;
    border-radius: 4px;
  }
  .stage {
    position: relative;
    min-height: 0;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .labels :global(span) {
    position: absolute;
    transform: translate(-50%, 0);
    font-size: 13px;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.8);
    color: #1f2630;
    white-space: nowrap;
  }
  .note {
    margin: 0;
    padding: 6px 16px;
    font-size: 13px;
  }
</style>
