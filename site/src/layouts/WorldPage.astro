---
/**
 * Every page of the site: the World full screen, with its hotspots and Data
 * Cards, and the UI floating over it as cards: the company name (top left),
 * the Landmark menu (top right), the dice and Seed (bottom left), and the
 * section's panel or the Overview's intro. The full-screen layout is on only
 * while `<html data-world="live">` (set in `Base.astro` when the browser
 * can draw the World; dropped if it fails to mount); without it the page is
 * a normal page that scrolls.
 *
 * The World's frame and its controls carry `transition:persist`, so the
 * client router moves the same canvas, renderer, meshes and camera into each
 * new page; only the panel and the rest of the page are swapped. The script
 * runs once and follows the route on every `astro:after-swap`.
 */
import Base from './Base.astro';
import LandmarkMenu from '../components/LandmarkMenu.astro';
import Logo from '../components/Logo.astro';
import { getCollection } from 'astro:content';
import { site, landmarksInStoryOrder, type DataCardMetric } from '../data/site';
import { MAX_TREES, PLACED_LANDMARK_IDS } from '../world';
import type { ContentCounts, LandmarkId } from '../world';
import { treeOrder } from '../lib/gardenTrees';

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const hasPanel = Astro.slots.has('panel');

const projects = treeOrder(await getCollection('projects'));
// The generator gets counts only: a tree per Project, a boat per Client, a ship per Partner.
const counts: ContentCounts = {
  projects: projects.length,
  clients: (await getCollection('clients')).length,
  partners: (await getCollection('partners')).length,
};

// One hotspot link per placed Landmark; the World positions them over its model.
const hotspots = site.landmarks.filter((l) => (PLACED_LANDMARK_IDS as readonly string[]).includes(l.id));
// The developer inside the House links to Team; the World shows it while the House is open.
const team = site.landmarks.find((l) => l.id === 'house-interior')!;
// One link per Garden tree, right after the Garden's own link: a tree per Project, in order by id, up to the cap.
const treeLinks = projects.slice(0, MAX_TREES);
// One Data Card per Landmark with a metric in site data, in Story Order; the World lays each over its Landmark.
const metrics: Partial<Record<LandmarkId, DataCardMetric>> = site.dataCards;
const dataCards = landmarksInStoryOrder.flatMap((landmark) => {
  const metric = metrics[landmark.id];
  return metric ? [{ id: landmark.id, metric }] : [];
});
---

<Base title={title} description={description}>
  <!--
    The HUD: every UI element floats over the full-screen World as a card.
    Top: the company name (left) and the Landmark menu (right); then the
    section panel or the Overview's intro, and the dice with the Seed. The
    World itself is fixed behind it all. Without the full-screen layout (no
    JS, no WebGPU or WebGL) the same HTML is a normal page that scrolls.
  -->
  <div class="hud">
    <header class="hud-bar" data-covers-world>
      {
        hasPanel ? (
          <a class="brand" href="/" data-seed-link>
            <Logo />
            <span class="brand-name">{site.company.name}</span>
          </a>
        ) : (
          <h1 class="brand">
            <Logo />
            <span class="brand-name">{site.company.name}</span>
          </h1>
        )
      }
      <LandmarkMenu />
    </header>

    <main class="hud-main">
      {
        hasPanel ? (
          <slot name="panel" />
        ) : (
          <section class="intro" data-covers-world aria-label="Introduction">
            <p class="tagline">{site.company.tagline}</p>
            <slot />
          </section>
        )
      }
      <div class="world" id="world-frame" transition:persist="world">
        <canvas
          id="world-canvas"
          aria-label={`A generated World for ${site.company.name}. Drag to pan, scroll or pinch to zoom.`}
          data-default-seed={site.defaultSeed}
          data-counts={JSON.stringify(counts)}></canvas>
        <ul class="data-cards" aria-label={`${site.company.name} in figures`}>
          {
            dataCards.map(({ id, metric }) => (
              <li class="data-card" data-card={id} hidden>
                <span class="data-card-value">{metric.value}</span> <span class="data-card-label">{metric.label}</span>
              </li>
            ))
          }
        </ul>
        {
          hotspots.map((landmark) => (
            <>
              <a class="hotspot" href={landmark.route} data-hotspot={landmark.id} data-seed-link draggable="false" hidden>
                <span class="hotspot-label">{landmark.label}</span>
              </a>
              {landmark.id === 'house' && (
                <a
                  class="hotspot developer"
                  href={team.route}
                  data-hotspot="house-interior"
                  data-developer
                  data-seed-link
                  draggable="false"
                  hidden>
                  <span class="hotspot-label">Meet the {team.label}</span>
                </a>
              )}
              {landmark.id === 'garden' &&
                treeLinks.map((project) => (
                  <a
                    class="hotspot tree"
                    href={`${landmark.route}/${project.id}`}
                    data-hotspot="garden"
                    data-project={project.id}
                    data-seed-link
                    draggable="false"
                    hidden>
                    <span class="hotspot-label">{project.data.title}</span>
                  </a>
                ))}
            </>
          ))
        }
      </div>
      <div class="world-controls" data-covers-world transition:persist="world-controls">
        <button type="button" class="dice" id="roll-seed">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="4" fill="none" stroke="currentColor" stroke-width="2"></rect>
            <circle cx="8" cy="8" r="1.6" fill="currentColor"></circle>
            <circle cx="16" cy="8" r="1.6" fill="currentColor"></circle>
            <circle cx="12" cy="12" r="1.6" fill="currentColor"></circle>
            <circle cx="8" cy="16" r="1.6" fill="currentColor"></circle>
            <circle cx="16" cy="16" r="1.6" fill="currentColor"></circle>
          </svg>
          Roll a new World
        </button>
        <p class="world-status" id="world-status" aria-live="polite"></p>
      </div>
    </main>
  </div>
</Base>

<script>
  import { navigate } from 'astro:transitions/client';
  import { mountWorld, type ScreenOffset, type WorldView } from '../render/mountWorld';
  import { freeCentre as freeCentreOf } from '../render/freeArea';
  import { createWorldSource } from '../render/worldSource';
  import type { CameraState } from '../render/cameraMath';
  import { rollSeed, seedFromUrl, withSeed, SEED_PARAM } from '../lib/seedUrl';
  import { landmarkForPath, routeView } from '../lib/landmarkRoutes';
  import type { ContentCounts, LandmarkId } from '../world';

  /** How long a camera flight to a Landmark takes; a cut under reduced motion. */
  const FLIGHT_MS = 900;
  /** How long the House's lid takes to lift or come down; a cut under reduced motion. */
  const ROOF_MS = 800;

  // The frame and controls are persisted, so these elements live for the whole visit.
  const canvas = document.querySelector<HTMLCanvasElement>('#world-canvas');
  const frame = document.querySelector<HTMLElement>('#world-frame');
  const dice = document.querySelector<HTMLButtonElement>('#roll-seed');
  const status = document.querySelector<HTMLElement>('#world-status');
  // No GPU (see `Base.astro`): no World to mount; the page stays the normal page that scrolls.
  if (canvas && frame && document.documentElement.dataset.world) {
    const hotspots = [...frame.querySelectorAll<HTMLElement>('[data-hotspot]')];
    const cards = [...frame.querySelectorAll<HTMLElement>('[data-card]')];
    const defaultSeed = canvas.dataset.defaultSeed ?? '';
    const counts = JSON.parse(canvas.dataset.counts ?? '{}') as ContentCounts;
    const source = createWorldSource();
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    /** The scene, mounted once with the first World; later Worlds are swapped in. */
    let mounting: Promise<WorldView> | null = null;
    /** Whether the scene has mounted (so the full-screen layout is earned). */
    let mounted = false;
    /** Only the latest request may show its World; older ones are dropped. */
    let latest = 0;
    /** The Seed of the World on show (or loading), as asked for in the URL. */
    let shownSeed: string | null = null;
    /** The Landmark of the route the camera last went to. */
    let shownLandmark: LandmarkId = 'overview';
    /** Where the camera was on the World before a section opened; closing returns there. */
    let worldState: CameraState | null = null;
    /** The World's Seed as generated (an over-long Seed falls back to the default). */
    let linkSeed = defaultSeed;

    const currentSeed = () => seedFromUrl(new URL(location.href)) ?? defaultSeed;
    const routeLandmark = () => landmarkForPath(location.pathname) ?? 'overview';
    const flightMs = () => (reducedMotion.matches ? 0 : FLIGHT_MS);

    /** Keep the Seed on links to other routes (e.g. `/garden?seed=1234`). */
    const keepSeedOnLinks = () => {
      for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-seed-link]')) {
        link.setAttribute('href', withSeed(link.getAttribute('href') ?? '/', linkSeed, defaultSeed, location.href));
      }
    };

    /**
     * Mark the World link of the page now open, if any: a Project's tree, or
     * the developer on Team (the links are persisted, so the page cannot).
     */
    const markCurrentLink = () => {
      const here = location.pathname.replace(/\/(index\.html)?$/, '');
      for (const link of frame.querySelectorAll<HTMLAnchorElement>('a[data-project], a[data-developer]')) {
        const current = new URL(link.href).pathname.replace(/\/$/, '') === here;
        if (current) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      }
    };

    /**
     * Where a Landmark should sit on the full-screen World so the floating
     * cards do not cover it: the middle of the part they leave free (beside
     * a side panel, above a bottom sheet, below the top bar).
     */
    const freeCentre = (): ScreenOffset => {
      const covers = [...document.querySelectorAll<HTMLElement>('[data-covers-world]')];
      return freeCentreOf(
        frame.getBoundingClientRect(),
        covers.map((cover) => cover.getBoundingClientRect()),
      );
    };

    /**
     * Move the camera for the route now showing: to its Landmark, or back to
     * where the World was left. `fresh`: a new World is in, so frame it.
     */
    const followRoute = (view: WorldView, ms: number, fresh = false) => {
      const id = routeLandmark();
      const { focus, interior } = routeView(id);
      const at = freeCentre();
      // Where the visitor looks: the Data Card shown is the one nearest it, and the pan bounds hold it.
      view.setViewCentre(at);
      // About and Team open the House: its lid lifts as the camera dives in; anywhere else it comes down.
      view.setInterior(interior, ms > 0 ? ROOF_MS : 0);
      if (id === 'overview') {
        // A section opened directly has no earlier view of the World: go to the Overview.
        if (worldState) void view.camera.flyTo(worldState, ms);
        else if (fresh || shownLandmark !== 'overview') void view.focus('overview', { at, ms });
        worldState = null;
      } else {
        if (shownLandmark === 'overview') worldState = view.camera.state;
        void view.focus(focus, { at, ms });
      }
      shownLandmark = id;
    };

    const showSeed = async (seed: string) => {
      const request = ++latest;
      shownSeed = seed;
      frame.setAttribute('aria-busy', 'true');
      try {
        const { world, meshed, ms } = await source.load(seed, counts);
        if (request !== latest) return;
        let view: WorldView;
        if (!mounting) {
          mounting = mountWorld(canvas, world, meshed, { frame, hotspots, cards });
          view = await mounting;
          mounted = true;
        } else {
          view = await mounting;
          if (request !== latest) return;
          view.show(world, meshed);
        }
        // A new World starts at its Overview: cut to the open section's Landmark, if any.
        worldState = null;
        shownLandmark = 'overview';
        followRoute(view, 0, true);
        canvas.dataset.generateMs = ms.toFixed(1);
        linkSeed = world.seed;
        keepSeedOnLinks();
        if (status) status.textContent = `Seed ${world.seed}`;
      } catch (error: unknown) {
        console.error('World render failed', error);
        // No World to show: fall back to the normal page that scrolls.
        if (!mounted) delete document.documentElement.dataset.world;
      } finally {
        if (request === latest) frame.removeAttribute('aria-busy');
      }
    };

    /** A new page is in: show its Seed's World, or move the camera for its route. */
    const onRoute = async () => {
      keepSeedOnLinks();
      markCurrentLink();
      if (currentSeed() !== shownSeed) return showSeed(currentSeed());
      if (!mounting) return;
      followRoute(await mounting, flightMs());
      // The panel is new content: move focus to it, as a page load would.
      document.querySelector<HTMLElement>('[data-panel]')?.focus({ preventScroll: true });
    };

    dice?.addEventListener('click', () => {
      const url = new URL(location.href);
      url.searchParams.set(SEED_PARAM, rollSeed(currentSeed()));
      // A navigation, so each roll is a history entry: Back returns to the previous World.
      void navigate(url.href);
    });

    // Escape closes an open section, like its close button; an open menu popover takes it first.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || event.defaultPrevented) return;
      if (document.querySelector(':popover-open')) return;
      document.querySelector<HTMLAnchorElement>('[data-panel-close]')?.click();
    });

    // The router swaps the <html> attributes: keep the full-screen layout on.
    document.addEventListener('astro:before-swap', (event) => {
      const { world } = document.documentElement.dataset;
      if (world) event.newDocument.documentElement.dataset.world = world;
    });
    document.addEventListener('astro:after-swap', () => void onRoute());
    // A resize can move the cards (a side panel becomes a bottom sheet): re-aim the Data Card.
    window.addEventListener('resize', () => {
      if (mounted) void mounting?.then((view) => view.setViewCentre(freeCentre()));
    });
    markCurrentLink();
    void showSeed(currentSeed());
  }
</script>

<style>
  /*
   * Without the full-screen layout (no JS, no WebGPU or WebGL): a normal
   * page that scrolls, the cards stacked in a column. The World and its
   * controls need JS and a GPU, so they are hidden.
   */
  .hud {
    max-width: 64rem;
    margin: 0 auto;
    padding: var(--gutter);
  }
  .hud-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: 0.5rem var(--gutter);
  }
  .hud-main {
    display: grid;
    gap: var(--gutter);
    margin-top: var(--gutter);
  }
  .world,
  .world-controls {
    display: none;
  }

  /* The floating card look shared by the company name, the intro and the controls. */
  .brand,
  .intro,
  .world-controls {
    border-radius: var(--card-radius);
    background: var(--card);
    box-shadow: var(--card-shadow);
    color: var(--ink);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.35rem 0.75rem 0.35rem 0.5rem;
    font: 1.875rem / 1.1 var(--font-heading);
    text-decoration: none;
  }
  a.brand:hover .brand-name,
  a.brand:focus-visible .brand-name {
    color: var(--brand-ink);
  }
  a.brand:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }
  .intro {
    box-sizing: border-box;
    max-width: 26rem;
    padding: 0.9rem 1.1rem 1rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .tagline {
    margin: 0 0 0.6rem;
    color: var(--brand-ink);
    font: 1.875rem / 1.05 var(--font-heading);
  }
  .intro :global(p:last-child) {
    margin-bottom: 0;
  }
  .world-controls {
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.9rem 0.4rem 0.4rem;
  }
  .dice {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.75rem 0.4rem;
    border: 0;
    border-radius: 4px;
    background: var(--brand-ink);
    color: var(--on-brand);
    cursor: pointer;
  }
  .dice:hover {
    background: color-mix(in oklab, var(--brand-ink) 80%, black);
  }
  .dice:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .world-status {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  /*
   * The full-screen World: the canvas fills the viewport, edge to edge, and
   * the page does not scroll. The HUD lies over it, letting the pointer
   * through everywhere but its cards.
   */
  :global(:root[data-world]),
  :global(:root[data-world] body) {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
  :global(:root[data-world]) .hud {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--gutter);
    max-width: none;
    height: 100dvh;
    box-sizing: border-box;
    pointer-events: none;
  }
  :global(:root[data-world]) .hud-bar {
    flex: none;
    flex-wrap: nowrap;
  }
  /* :global(*): the menu and the panel are other components, outside this scope. */
  :global(:root[data-world]) .hud-bar > :global(*),
  :global(:root[data-world]) .hud-main > :global(*) {
    pointer-events: auto;
  }
  :global(:root[data-world]) .hud-main {
    flex: 1;
    min-height: 0;
    margin: 0;
    /* Desktop: intro (or nothing) at the left, a panel at the right, the controls at the bottom left. */
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: minmax(0, 1fr) auto;
  }
  :global(:root[data-world]) .intro {
    grid-area: 1 / 1;
    align-self: start;
    justify-self: start;
    max-height: 100%;
  }
  :global(:root[data-world]) .hud-main > :global([data-panel]) {
    grid-area: 1 / 2 / -1 / 3;
    align-self: start;
    justify-self: end;
    max-height: 100%;
  }
  :global(:root[data-world]) .world-controls {
    display: flex;
    grid-area: 2 / 1;
    align-self: end;
    justify-self: start;
  }
  :global(:root[data-world]) .world {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: block;
    height: 100dvh;
    /* clip, not hidden: a focused hotspot must not scroll the frame. */
    overflow: clip;
    /* The World takes every touch gesture: one finger pans, two pinch. */
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
    background: var(--surface);
  }
  /* Phones: the panel (or intro) is a bottom sheet, the controls just above it. */
  @media (max-width: 47.99rem) {
    .brand,
    .tagline {
      font-size: 1.40625rem;
    }
    :global(:root[data-world]) .hud-main {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto auto;
    }
    :global(:root[data-world]) .world-controls {
      grid-area: 2 / 1;
    }
    :global(:root[data-world]) .intro,
    :global(:root[data-world]) .hud-main > :global([data-panel]) {
      grid-area: 3 / 1;
      justify-self: stretch;
      max-width: none;
      max-height: 55dvh;
    }
    :global(:root[data-world]) .intro {
      max-height: 40dvh;
    }
  }
  .world[data-dragging] {
    cursor: grabbing;
  }
  .world canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Data Cards: laid on the isometric plane by a matrix3d from the camera; never take the pointer. */
  .data-cards {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }
  .data-card {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    max-width: 11rem;
    padding: 0.35rem 0.6rem 0.4rem;
    border-left: 3px solid var(--brand);
    border-radius: 4px;
    background: color-mix(in oklab, var(--paper) 92%, transparent);
    box-shadow: 0 4px 14px oklch(0.2 0.02 250 / 0.16);
    color: var(--ink);
    line-height: 1.2;
    transform-origin: 0 0;
    opacity: 0;
    transition: opacity 200ms;
  }
  .data-card[data-near] {
    opacity: 1;
  }
  .data-card-value {
    color: var(--brand-ink);
    font-family: var(--font-heading);
    font-size: 1.40625rem;
    font-variant-numeric: tabular-nums;
  }
  .data-card-label {
    font-size: 1rem;
  }
  @media (max-width: 47.99rem) {
    .data-card {
      max-width: 8.5rem;
      padding: 0.25rem 0.45rem 0.3rem;
    }
    .data-card-value {
      font-size: 1.171875rem;
    }
    .data-card-label {
      font-size: 0.9375rem;
    }
  }
  .hotspot {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 4px;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    -webkit-user-drag: none;
  }
  .world[data-dragging] .hotspot {
    cursor: grabbing;
  }
  .hotspot-label {
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    translate: -50% 0;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: var(--brand-ink);
    color: var(--on-brand);
    font-size: 1rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms;
  }
  .hotspot:hover,
  .hotspot:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
    background: color-mix(in oklab, var(--brand) 18%, transparent);
  }
  .hotspot:hover .hotspot-label,
  .hotspot:focus-visible .hotspot-label {
    opacity: 1;
  }
  /* A tree too small on screen to aim at: the pointer goes to the Garden's link under it. */
  .hotspot.tree[data-small] {
    pointer-events: none;
  }
  /* The developer in the open House: above the House's own link, which covers the room. */
  .hotspot.developer {
    z-index: 1;
  }
  /* The tree of the Project page that is open, and the developer on Team. */
  .hotspot.tree[aria-current='page'],
  .hotspot.developer[aria-current='page'] {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }
  @media (prefers-reduced-motion: reduce) {
    .hotspot-label,
    .data-card {
      transition: none;
    }
  }
</style>
