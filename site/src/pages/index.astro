---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import LandmarkMenu from '../components/LandmarkMenu.astro';
import { site } from '../data/site';
import { PLACED_LANDMARK_IDS } from '../world';
import type { ContentCounts } from '../world';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing pages/home.mdx');
const { Content: Hook } = await render(home);

// The Project, Client and Partner collections arrive in later tickets.
const counts: ContentCounts = { projects: 0, clients: 0, partners: 0 };

// One hotspot link per placed Landmark; the World positions them over its model.
const hotspots = site.landmarks.filter((l) => (PLACED_LANDMARK_IDS as readonly string[]).includes(l.id));
---

<Base>
  <header class="hero">
    <h1>{site.company.name}</h1>
    <p class="tagline">{site.company.tagline}</p>
  </header>

  <main>
    <div class="world" id="world-frame">
      <canvas
        id="world-canvas"
        aria-label={`A generated World for ${site.company.name}. Drag to pan, scroll or pinch to zoom.`}
        data-default-seed={site.defaultSeed}
        data-counts={JSON.stringify(counts)}></canvas>
      {
        hotspots.map((landmark) => (
          <a class="hotspot" href={landmark.route} data-hotspot={landmark.id} data-seed-link draggable="false" hidden>
            <span class="hotspot-label">{landmark.label}</span>
          </a>
        ))
      }
    </div>
    <div class="world-controls">
      <button type="button" class="dice" id="roll-seed">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <rect x="3" y="3" width="18" height="18" rx="4" fill="none" stroke="currentColor" stroke-width="2"></rect>
          <circle cx="8" cy="8" r="1.6" fill="currentColor"></circle>
          <circle cx="16" cy="8" r="1.6" fill="currentColor"></circle>
          <circle cx="12" cy="12" r="1.6" fill="currentColor"></circle>
          <circle cx="8" cy="16" r="1.6" fill="currentColor"></circle>
          <circle cx="16" cy="16" r="1.6" fill="currentColor"></circle>
        </svg>
        Roll a new World
      </button>
      <p class="world-status" id="world-status" aria-live="polite"></p>
    </div>
    <LandmarkMenu />
    <section class="hook"><Hook /></section>
  </main>
</Base>

<script>
  import { mountWorld, type WorldView } from '../render/mountWorld';
  import { createWorldSource } from '../render/worldSource';
  import { rollSeed, seedFromUrl, withSeed, SEED_PARAM } from '../lib/seedUrl';
  import type { ContentCounts } from '../world';

  const canvas = document.querySelector<HTMLCanvasElement>('#world-canvas');
  const frame = document.querySelector<HTMLElement>('#world-frame');
  const dice = document.querySelector<HTMLButtonElement>('#roll-seed');
  const status = document.querySelector<HTMLElement>('#world-status');
  if (canvas && frame) {
    const hotspots = [...frame.querySelectorAll<HTMLElement>('[data-hotspot]')];
    const defaultSeed = canvas.dataset.defaultSeed ?? '';
    const counts = JSON.parse(canvas.dataset.counts ?? '{}') as ContentCounts;
    const source = createWorldSource();
    /** The scene, mounted once with the first World; later Worlds are swapped in. */
    let mounting: Promise<WorldView> | null = null;
    /** Only the latest request may show its World; older ones are dropped. */
    let latest = 0;

    const currentSeed = () => seedFromUrl(new URL(location.href)) ?? defaultSeed;

    /** Keep the Seed on links to other routes (e.g. `/garden?seed=1234`). */
    const keepSeedOnLinks = (seed: string) => {
      for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-seed-link]')) {
        link.setAttribute('href', withSeed(link.getAttribute('href') ?? '/', seed, defaultSeed, location.href));
      }
    };

    const showSeed = async (seed: string) => {
      const request = ++latest;
      canvas.parentElement?.setAttribute('aria-busy', 'true');
      try {
        const { world, meshed, ms } = await source.load(seed, counts);
        if (request !== latest) return;
        if (!mounting) {
          mounting = mountWorld(canvas, world, meshed, { frame, hotspots });
          await mounting;
        } else {
          const view = await mounting;
          if (request !== latest) return;
          view.show(world, meshed);
        }
        canvas.dataset.generateMs = ms.toFixed(1);
        keepSeedOnLinks(world.seed);
        if (status) status.textContent = `Seed ${world.seed}`;
      } catch (error: unknown) {
        console.error('World render failed', error);
      } finally {
        if (request === latest) canvas.parentElement?.removeAttribute('aria-busy');
      }
    };

    dice?.addEventListener('click', () => {
      const seed = rollSeed(currentSeed());
      const url = new URL(location.href);
      url.searchParams.set(SEED_PARAM, seed);
      // pushState: each roll is a history entry, so Back returns to the previous World.
      history.pushState({ seed }, '', url);
      void showSeed(seed);
    });
    window.addEventListener('popstate', () => void showSeed(currentSeed()));

    void showSeed(currentSeed());
  }
</script>

<style>
  .hero,
  main {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .hero h1 {
    margin: 1.5rem 0 0.25rem;
  }
  .tagline {
    margin: 0 0 1rem;
  }
  .world {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 6px;
    /* clip, not hidden: a focused hotspot must not scroll the frame. */
    overflow: clip;
    /* The World takes every touch gesture: one finger pans, two pinch. */
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
    background: var(--surface);
    margin-bottom: 0.75rem;
  }
  .world-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .dice {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    border: 0;
    border-radius: 4px;
    background: var(--brand);
    color: var(--on-brand);
    font: inherit;
    cursor: pointer;
  }
  .dice:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .world-status {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .world[data-dragging] {
    cursor: grabbing;
  }
  .world canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hotspot {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 4px;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    -webkit-user-drag: none;
  }
  .world[data-dragging] .hotspot {
    cursor: grabbing;
  }
  .hotspot-label {
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    translate: -50% 0;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: var(--brand);
    color: var(--on-brand);
    font-size: 0.85rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms;
  }
  .hotspot:hover,
  .hotspot:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
    background: color-mix(in oklab, var(--brand) 18%, transparent);
  }
  .hotspot:hover .hotspot-label,
  .hotspot:focus-visible .hotspot-label {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hotspot-label {
      transition: none;
    }
  }
</style>
