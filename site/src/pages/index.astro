---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import LandmarkMenu from '../components/LandmarkMenu.astro';
import { site } from '../data/site';
import type { ContentCounts } from '../world';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing pages/home.mdx');
const { Content: Hook } = await render(home);

// The Project, Client and Partner collections arrive in later tickets.
const counts: ContentCounts = { projects: 0, clients: 0, partners: 0 };
---

<Base>
  <header class="hero">
    <h1>{site.company.name}</h1>
    <p class="tagline">{site.company.tagline}</p>
  </header>

  <main>
    <div class="world">
      <canvas
        id="world-canvas"
        aria-label={`A generated World for ${site.company.name}`}
        data-seed={site.defaultSeed}
        data-counts={JSON.stringify(counts)}></canvas>
    </div>
    <LandmarkMenu />
    <section class="hook"><Hook /></section>
  </main>
</Base>

<script>
  import { mountWorld } from '../render/mountWorld';
  import { generateWorld, type ContentCounts } from '../world';

  const canvas = document.querySelector<HTMLCanvasElement>('#world-canvas');
  if (canvas) {
    const seed = canvas.dataset.seed ?? '';
    const counts = JSON.parse(canvas.dataset.counts ?? '{}') as ContentCounts;
    mountWorld(canvas, generateWorld(seed, counts)).catch((error: unknown) => {
      console.error('World render failed', error);
    });
  }
</script>

<style>
  .hero,
  main {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .hero h1 {
    margin: 1.5rem 0 0.25rem;
  }
  .tagline {
    margin: 0 0 1rem;
  }
  .world {
    aspect-ratio: 16 / 10;
    border-radius: 6px;
    overflow: hidden;
    background: var(--surface);
    margin-bottom: 1rem;
  }
  .world canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
