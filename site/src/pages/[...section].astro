---
/**
 * One static page per Landmark section (every Landmark but the Overview),
 * from the Landmark list in the site data module: `/services`, `/about`,
 * `/about/team`, `/garden`, `/dock`, `/contact`. Each shows its intro copy
 * from the `pages` collection in a panel over the World, with what the
 * section lists (`SectionContent.astro`): the Station's every Service, the
 * Garden's every Project (each Project's page is `garden/[slug].astro`), the
 * Dock's every Client and Partner, Team's every Team Member, and Contact's
 * contact details (no form). About links on to Team (as does the developer
 * in the World's open House).
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import WorldPage from '@/layouts/WorldPage.astro';
import SectionPanel from '@/components/SectionPanel.astro';
import SectionContent from '@/components/SectionContent.astro';
import { site } from '@/data/site';

export const getStaticPaths = (async () => {
  const pages = await getCollection('pages');
  return site.landmarks
    .filter((landmark) => landmark.route !== '/')
    .map((landmark) => {
      const page = pages.find((p) => p.data.landmark === landmark.id);
      if (!page) throw new Error(`No pages entry with landmark: ${landmark.id} (for ${landmark.route})`);
      return { params: { section: landmark.route.replace(/^\/+|\/+$/g, '') }, props: { landmark, page } };
    });
}) satisfies GetStaticPaths;

const { landmark, page } = Astro.props;
---

<WorldPage title={`${page.data.title} · ${site.company.name}`} description={page.data.description}>
  <SectionPanel slot="panel" title={page.data.title} id={landmark.id}>
    <SectionContent landmark={landmark} />
  </SectionPanel>
</WorldPage>
