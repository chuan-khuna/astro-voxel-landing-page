---
/**
 * One static page per Landmark section (every Landmark but the Overview),
 * from the Landmark list in the site data module: `/services`, `/about`,
 * `/about/team`, `/garden`, `/dock`, `/contact`. Each shows its intro copy
 * from the `pages` collection in a panel over the World; the Station's also
 * lists every Service, the Garden's every Project (each Project's page is
 * `garden/[slug].astro`), the Dock's every Client and Partner, and Team's
 * every Team Member. About links on to Team (as does the developer in the
 * World's open House).
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import WorldPage from '../layouts/WorldPage.astro';
import SectionPanel from '../components/SectionPanel.astro';
import ProjectList from '../components/ProjectList.astro';
import ServiceList from '../components/ServiceList.astro';
import DockList from '../components/DockList.astro';
import TeamList from '../components/TeamList.astro';
import { site } from '../data/site';

export const getStaticPaths = (async () => {
  const pages = await getCollection('pages');
  return site.landmarks
    .filter((landmark) => landmark.route !== '/')
    .map((landmark) => {
      const page = pages.find((p) => p.data.landmark === landmark.id);
      if (!page) throw new Error(`No pages entry with landmark: ${landmark.id} (for ${landmark.route})`);
      return { params: { section: landmark.route.replace(/^\/+|\/+$/g, '') }, props: { landmark, page } };
    });
}) satisfies GetStaticPaths;

const { landmark, page } = Astro.props;
const { Content } = await render(page);
const { company } = site;
const team = site.landmarks.find((l) => l.id === 'house-interior')!;
---

<WorldPage title={`${page.data.title} · ${company.name}`} description={page.data.description}>
  <SectionPanel slot="panel" title={page.data.title}>
    <Content />
    {landmark.id === 'station' && <ServiceList />}
    {landmark.id === 'garden' && <ProjectList route={landmark.route} />}
    {landmark.id === 'dock' && <DockList />}
    {
      landmark.id === 'house' && (
        <p class="next">
          <a href={team.route} data-seed-link>
            Meet the {team.label} →
          </a>
        </p>
      )
    }
    {landmark.id === 'house-interior' && <TeamList />}
    {
      landmark.id === 'mailbox' && (
        <dl class="contact">
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${company.email}`}>{company.email}</a>
          </dd>
          <dt>Phone</dt>
          <dd>
            <a href={`tel:${company.phone.replaceAll(' ', '')}`}>{company.phone}</a>
          </dd>
          <dt>Address</dt>
          <dd>{company.address}</dd>
          {company.socials.map((social) => (
            <>
              <dt>{social.label}</dt>
              <dd>
                <a href={social.url}>{social.url.replace(/^https:\/\//, '')}</a>
              </dd>
            </>
          ))}
        </dl>
      )
    }
  </SectionPanel>
</WorldPage>

<style>
  .contact {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 1rem;
    margin: 1rem 0 0;
  }
  .contact dt {
    font-weight: 600;
  }
  .contact dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .contact a,
  .next a {
    color: var(--brand-ink);
  }
</style>
