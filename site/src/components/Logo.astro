---
/**
 * The company's logo mark: one isometric voxel in the brand colour, its
 * three faces in three shades. Decorative; the company name beside it is
 * the text.
 */
---

<svg class="logo" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
  <path d="M16 3 28 10 16 17 4 10Z" style="fill: color-mix(in oklab, var(--brand) 55%, white)"></path>
  <path d="M4 10 16 17V30L4 23Z" style="fill: var(--brand)"></path>
  <path d="M28 10 16 17V30L28 23Z" style="fill: color-mix(in oklab, var(--brand) 70%, black)"></path>
</svg>

<style>
  .logo {
    display: block;
    flex: none;
  }
</style>
