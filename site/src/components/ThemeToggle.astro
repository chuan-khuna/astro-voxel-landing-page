---
/**
 * The theme toggle: one icon button that cycles Auto (follow the system),
 * Day and Night, showing the icon of the choice in force (a monitor, a sun,
 * a moon). The choice is kept in `localStorage` and set on `<html>` before
 * first paint by the boot script in `Base.astro`, so it holds across routes
 * and reloads with no flash. It needs JS, so it is hidden without it (the
 * page then follows the system's preference through CSS alone).
 */
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Theme" title="Theme">
  <svg class="icon auto" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <rect x="3" y="4" width="18" height="12" rx="1.5" fill="none" stroke="currentColor" stroke-width="2"></rect>
    <path d="M9 20h6M12 16v4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
  </svg>
  <svg class="icon day" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path
      d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"></path>
  </svg>
  <svg class="icon night" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"
    ></path>
  </svg>
</button>

<script>
  import { THEME_STORAGE_KEY, nextThemeChoice, parseThemeChoice, resolveTheme, type ThemeChoice } from '@/lib/theme';

  const LABELS: Record<ThemeChoice, string> = { auto: 'Auto', day: 'Day', night: 'Night' };
  const root = document.documentElement;
  const dark = window.matchMedia('(prefers-color-scheme: dark)');
  const choice = () => parseThemeChoice(root.dataset.themeChoice);

  /** Set the choice and the theme it shows on `<html>`, and label the toggle. */
  const apply = (next: ThemeChoice) => {
    root.dataset.themeChoice = next;
    root.dataset.theme = resolveTheme(next, dark.matches);
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      const label = `Theme: ${LABELS[next]}${next === 'auto' ? ' (follows your system)' : ''}. Switch to ${LABELS[nextThemeChoice(next)]}`;
      button.setAttribute('aria-label', label);
      button.title = label;
    }
  };

  // Delegated: the router swaps the header (and this button) on every route.
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) return;
    const next = nextThemeChoice(choice());
    try {
      if (next === 'auto') localStorage.removeItem(THEME_STORAGE_KEY);
      else localStorage.setItem(THEME_STORAGE_KEY, next);
    } catch {
      // Storage blocked: the choice holds for this visit only.
    }
    apply(next);
  });
  // Auto follows the system as it changes.
  dark.addEventListener('change', () => apply(choice()));
  // The router replaces <html>'s attributes with the new page's: carry the theme across.
  document.addEventListener('astro:before-swap', (event) => {
    const { theme, themeChoice } = root.dataset;
    const next = event.newDocument.documentElement.dataset;
    if (theme) next.theme = theme;
    if (themeChoice) next.themeChoice = themeChoice;
  });
  document.addEventListener('astro:after-swap', () => apply(choice()));
  apply(choice());
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    /* 44px square with its 22px icon: a comfortable tap. */
    padding: 0.6875rem;
    border: 0;
    border-radius: var(--card-radius);
    background: var(--card);
    box-shadow: var(--card-shadow);
    color: var(--ink);
    cursor: pointer;
  }
  /* Only where there is a real hover: a tap must not leave it lit. */
  @media (hover: hover) {
    .theme-toggle:hover {
      background: var(--brand-ink);
      color: var(--on-brand);
    }
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }
  /* Without JS there is no choice to make: the page follows the system. */
  :global(:root:not([data-theme-choice])) .theme-toggle {
    display: none;
  }
  .icon {
    display: none;
  }
  :global(:root[data-theme-choice='auto']) .icon.auto,
  :global(:root[data-theme-choice='day']) .icon.day,
  :global(:root[data-theme-choice='night']) .icon.night {
    display: block;
  }
</style>
