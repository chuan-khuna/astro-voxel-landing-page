---
import { landmarksInStoryOrder } from '../data/site';
import { landmarkForPath } from '../lib/landmarkRoutes';

// The section this page belongs to is marked as the current page.
const current = landmarkForPath(Astro.url.pathname);
---

<nav class="landmark-menu" aria-label="Landmarks">
  <ol>
    {
      landmarksInStoryOrder.map((landmark) => (
        <li>
          <a
            href={landmark.route}
            data-landmark={landmark.id}
            data-seed-link
            aria-current={landmark.id === current ? 'page' : undefined}>
            {landmark.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .landmark-menu ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .landmark-menu a {
    display: inline-block;
    padding: 0.4rem 0.75rem;
    border-radius: 4px;
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  .landmark-menu a[aria-current='page'] {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }
  .landmark-menu a:hover,
  .landmark-menu a:focus-visible {
    background: var(--brand);
    color: var(--on-brand);
  }
</style>
