---
/**
 * A section page's panel over the World: a floating card at the right on
 * desktop, one card of the Story Scroll on phones. It is plain static HTML,
 * so the section reads in full without JS. The close link goes back to the
 * World (`/`, keeping the Seed); Escape does the same when JS runs. The
 * Story Scroll has no close link: the page scrolls on to the next section.
 *
 * The page's own panel has its title as the page's `h1`; the other sections
 * standing in the Story Scroll on the same page take an `h2`.
 */
interface Props {
  title: string;
  /** Unique on the page: the title's id is `panel-<id>`. */
  id: string;
  /** The title's heading level: 1 for the page's own panel (the default), 2 for another section on the page. */
  level?: 1 | 2;
}
const { title, id, level = 1 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
const titleId = `panel-${id}`;
---

<aside class="panel" data-panel data-covers-world data-story-card tabindex="-1" aria-labelledby={titleId}>
  <div class="panel-head">
    <Heading class="panel-title" id={titleId}>{title}</Heading>
    <a class="panel-close" href="/" data-seed-link data-panel-close aria-label={`Close ${title} and return to the World`} title="Close">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </a>
  </div>
  <div class="panel-body">
    <slot />
  </div>
</aside>

<style>
  /*
   * A floating rounded card. Its place is set by the page (`WorldPage.astro`):
   * on desktop at the right, below the menu, as tall as its content and no
   * taller than the screen; on phones a bottom sheet. Long content scrolls
   * inside the card. Without the full-screen layout it is a card in the page.
   */
  .panel {
    box-sizing: border-box;
    width: min(27rem, 42vw);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.9rem 1.25rem 1.25rem;
    border-radius: var(--card-radius);
    background: var(--card);
    color: var(--ink);
    box-shadow: var(--card-shadow);
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklab, var(--ink) 35%, transparent) transparent;
    animation: panel-in 220ms ease-out;
    --panel-from: translateX(1.5rem);
  }
  /* In a page that scrolls, the card takes the column's width. */
  :global(:root:not([data-world])) .panel {
    width: auto;
  }
  .panel:focus {
    outline: none;
  }
  .panel:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }
  .panel-head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }
  .panel-title {
    margin: 0.1rem 0 0.5rem;
    font-size: 2.8125rem;
  }
  .panel-close {
    display: inline-flex;
    flex: none;
    padding: 0.35rem;
    border-radius: 4px;
    color: var(--ink);
  }
  /* On a touch screen the close link is at least 44px square to tap. */
  @media (pointer: coarse) {
    .panel-close {
      padding: 0.75rem;
      margin: -0.4rem -0.6rem 0 0;
    }
  }
  .panel-close:hover,
  .panel-close:focus-visible {
    background: var(--brand-ink);
    color: var(--on-brand);
  }
  .panel-body :global(p) {
    line-height: 1.3;
  }

  /* Narrow screens: full width; with the World, a bottom sheet. */
  @media (max-width: 47.99rem) {
    .panel {
      width: auto;
      padding: 0.75rem 1rem 1rem;
      --panel-from: translateY(1.5rem);
    }
    .panel-title {
      font-size: 1.875rem;
    }
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: var(--panel-from, none);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel {
      animation: none;
    }
  }
</style>
